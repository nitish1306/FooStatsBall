# Environments & Virtual Envs
venv/
.venv/
env/
ENV/

# Python Cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Model Checkpoints & Large Assets
models/
*.pt
*.pth
*.onnx
*.engine

# Video Files & Raw Media (managed via Git LFS or ignored)
output/*.mp4
*.avi
*.mov
*.mkv
*.jpg
*.jpeg
*.png
!static/css/*
!static/js/*

# Telemetry outputs & temp files
output/*
!output/.gitkeep
!output/calibration.json
!output/telemetry.json

# Environment variables
.env
.env.*
export/
